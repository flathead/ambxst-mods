{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.audio-device-switcher",
  "name": "Audio device switcher",
  "version": "1.1.1",
  "description": "Adds a bar popup for changing the default PipeWire input and output devices.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "authorUrl": "https://github.com/flathead",
  "homepage": "https://github.com/flathead/ambxst-mods/tree/main/packages/audio-device-switcher",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.8 <1.4.0",
    "testedBaseCommits": [
      "c33dd43da5fb6feeefa521bd1f406b8ff20db577"
    ]
  },
  "permissions": [
    "Reads PipeWire devices and changes the default audio source or sink",
    "Reads headset battery status from ArctisManager over the session D-Bus when available"
  ],
  "operations": [
    {
      "type": "patch",
      "source": "patches/feature.patch"
    }
  ],
  "changelog": "CHANGELOG.md",
  "deprecated": false,
  "localization": {
    "mode": "translated",
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ru",
      "es"
    ]
  }
}

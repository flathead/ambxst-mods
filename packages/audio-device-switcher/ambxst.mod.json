{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.audio-device-switcher",
  "name": "Audio device switcher",
  "version": "1.0.0",
  "description": "Adds a bar popup for changing the default PipeWire input and output devices.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.2.5 <1.3.0",
    "testedBaseCommits": ["8f00dbaa831824e24af3a1644d32ae465acc60ea"]
  },
  "dependencies": ["community.i18n"],
  "dependencySources": {
    "community.i18n": "https://github.com/flathead/ambxst-mod-i18n.git"
  },
  "permissions": ["Reads PipeWire devices and changes the default audio source or sink"],
  "operations": [{"type": "patch", "source": "patches/feature.patch"}]
}

{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.keyboard-layout-indicator",
  "name": "Keyboard layout indicator",
  "version": "1.1.1",
  "description": "Shows the active Hyprland keyboard layout in the bar and provides a layout picker.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "authorUrl": "https://github.com/flathead",
  "homepage": "https://github.com/flathead/ambxst-mods/tree/main/packages/keyboard-layout-indicator",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.8 <1.4.0",
    "testedBaseCommits": [
      "c33dd43da5fb6feeefa521bd1f406b8ff20db577"
    ]
  },
  "commands": [
    "hyprctl",
    "sh",
    "awk"
  ],
  "permissions": [
    "Reads Hyprland keyboard devices and changes the active layout"
  ],
  "operations": [
    {
      "type": "patch",
      "source": "patches/feature.patch"
    }
  ],
  "changelog": "CHANGELOG.md",
  "deprecated": false,
  "localization": {
    "mode": "translated",
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ru",
      "es"
    ]
  }
}

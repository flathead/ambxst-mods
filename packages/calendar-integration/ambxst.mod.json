{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.calendar-integration",
  "name": "Calendar integration",
  "version": "1.0.0",
  "description": "Adds Google Calendar and CalDAV accounts, event editing, reminders, and bar integration.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "authorUrl": "https://github.com/flathead",
  "homepage": "https://github.com/flathead/ambxst-mods/tree/main/packages/calendar-integration",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.2.5 <1.3.0",
    "testedBaseCommits": [
      "fae62f730f2cf806d070c1331773407acd1342e9"
    ]
  },
  "dependencies": [
    "community.i18n"
  ],
  "dependencySources": {
    "community.i18n": "https://github.com/flathead/ambxst-mod-i18n.git"
  },
  "commands": [
    "python3",
    "notify-send"
  ],
  "permissions": [
    "Connects to calendar providers configured by the user",
    "Stores OAuth or CalDAV credentials in the user's Ambxst data directory",
    "Sends desktop notifications for calendar reminders"
  ],
  "operations": [
    {
      "type": "patch",
      "source": "patches/feature.patch"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.calendar-integration",
  "name": "Calendar integration",
  "version": "1.2.0",
  "description": "Adds Google Calendar and CalDAV accounts, event editing, reminders, and bar integration.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "authorUrl": "https://github.com/flathead",
  "homepage": "https://github.com/flathead/ambxst-mods/tree/main/packages/calendar-integration",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.8 <1.4.0",
    "testedBaseCommits": [
      "2a704c438ddc0b94a11f4e4cf32a16220b62141f",
      "c33dd43da5fb6feeefa521bd1f406b8ff20db577",
      "1e1a56493582f34e5e5593bc9d3c2f87246266fb",
      "c62a7acc443dbb1c9045e83466402528cc522af2",
      "3705f278f24a74718fc23772b47044e96701d53a",
      "bc60230283a3822eec2e23c949f44990480d0f43",
      "9a9fb6886138931b0825bb2066ac5595ab11a139"
    ]
  },
  "commands": [
    "python3",
    "notify-send",
    "xdg-open"
  ],
  "permissions": [
    "Connects to calendar providers configured by the user",
    "Stores OAuth or CalDAV credentials in the user's Ambxst data directory",
    "Sends desktop notifications for calendar reminders",
    "Opens calendar event and meeting links in the default browser",
    "Reads existing gcalcli credentials when the user imports them",
    "Plays reminder sounds, including an optional audio file selected by the user"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/services/CalendarEventSelection.js",
      "target": "modules/services/CalendarEventSelection.js"
    },
    {
      "type": "patch",
      "source": "patches/feature.patch"
    }
  ],
  "changelog": "CHANGELOG.md",
  "deprecated": false,
  "localization": {
    "mode": "translated",
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ru",
      "es"
    ]
  }
}

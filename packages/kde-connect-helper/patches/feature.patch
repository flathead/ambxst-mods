index ee1392e0..7b206397 100644
--- a/modules/bar/systray/SysTray.qml
+++ b/modules/bar/systray/SysTray.qml
@@ -20,12 +20,21 @@ StyledRect {
     property bool vertical: bar.orientation === "vertical"

     readonly property var allItems: SystemTray.items?.values ?? []
+    readonly property var eligibleItems: allItems.filter(item =>
+        !KdeConnectService.hideKdeConnectTrayIcon || !isKdeConnectItem(item))
     readonly property var hiddenIds: StateService.systrayHidden
-    readonly property var visibleItems: allItems.filter(item => !hiddenIds.includes(item.id))
-    readonly property var overflowItems: allItems.filter(item => hiddenIds.includes(item.id))
+    readonly property var visibleItems: eligibleItems.filter(item => !hiddenIds.includes(item.id))
+    readonly property var overflowItems: eligibleItems.filter(item => hiddenIds.includes(item.id))

     // The tray collapses to a chevron-only pill while every icon is in the popup
-    readonly property bool hasItems: allItems.length > 0
+    readonly property bool hasItems: eligibleItems.length > 0
+
+    function isKdeConnectItem(item) {
+        const identity = [item?.id, item?.title, item?.icon]
+            .map(value => String(value ?? "").toLowerCase())
+            .join(" ");
+        return identity.includes("kde connect") || identity.includes("kdeconnect");
+    }

     // Menu popup currently opened from an icon inside the overflow popup
     property var activeChildMenu: null

{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "community.bar-resource-monitor",
  "name": "Bar resource monitor",
  "version": "1.1.2",
  "description": "Adds configurable CPU, memory, GPU, disk, and temperature metrics to the bar.",
  "license": "AGPL-3.0-only",
  "author": "flathead",
  "authorUrl": "https://github.com/flathead",
  "homepage": "https://github.com/flathead/ambxst-mods/tree/main/packages/bar-resource-monitor",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.8 <1.4.0",
    "testedBaseCommits": [
      "2a704c438ddc0b94a11f4e4cf32a16220b62141f",
      "c33dd43da5fb6feeefa521bd1f406b8ff20db577"
    ]
  },
  "permissions": [
    "Reads system resource metrics from the existing Ambxst backend service"
  ],
  "operations": [
    {
      "type": "patch",
      "source": "patches/feature.patch"
    },
    {
      "type": "patch",
      "source": "patches/localization.patch"
    }
  ],
  "changelog": "CHANGELOG.md",
  "deprecated": false,
  "localization": {
    "mode": "translated",
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ru",
      "es"
    ]
  }
